{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=nimpulse.db"
  },
  "Auth": {
    "JwtSigningKey": "dev-only-insecure-signing-key-change-me",
    "Issuer": "NimPulse",
    "Audience": "NimPulse",
