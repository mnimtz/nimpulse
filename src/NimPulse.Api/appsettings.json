  },
  "Ai": {
    "DefaultProvider": "claude",
    "Claude": {
      "ApiKey": "",
      "Model": "claude-sonnet-5"
    },
    "AzureOpenAi": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": ""
    }
  }
}
