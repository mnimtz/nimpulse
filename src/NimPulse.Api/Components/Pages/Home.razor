@page "/"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using NimPulse.Core.Auth
@using NimPulse.Core.Health
@inject NimPulseDbContext Db
@inject ReportService ReportService
@inject DailyScoreService DailyScoreService

<PageTitle>Dashboard — NimPulse</PageTitle>

<h1>Dashboard</h1>

@if (!isLoaded)
{
    <p>Lädt…</p>
}
else if (!hasAnyData)
{
    <div class="empty-state">
        <p>Noch keine Health-Daten synchronisiert.</p>
        <p class="hint">Öffne die NimPulse-iOS-App und aktiviere den Sync in den Einstellungen.</p>
    </div>
}
else
{
    <div class="day-nav">
        <a class="day-nav-link" href="@("/?date=" + SelectedDate.AddDays(-1).ToString("yyyy-MM-dd"))">‹ Vorheriger Tag</a>
        <span class="day-nav-current">@FormatDayLabel(SelectedDate)</span>
        @if (SelectedDate < DateOnly.FromDateTime(DateTime.Now))
        {
            <a class="day-nav-link" href="@("/?date=" + SelectedDate.AddDays(1).ToString("yyyy-MM-dd"))">Nächster Tag ›</a>
        }
        else
        {
            <span class="day-nav-link day-nav-link-disabled">Nächster Tag ›</span>
        }
    </div>

    @if (score is not null)
    {
        <div class="score-card">
            <div class="score-card-value">
                @if (score.Score is { } value)
                {
                    @($"{value:0}")
                }
                else
                {
                    <span class="score-card-empty">–</span>
                }
            </div>
            <div class="score-card-label">Tages-Score</div>
            <div class="score-card-components">
                @foreach (var component in score.Components)
                {
                    <div class="score-card-component">
                        <span class="score-card-component-label">@HealthTypeCatalog.GetDisplayName(component.Type)</span>
                        <span class="score-card-component-value">
                            @(component.Value is { } v ? $"{v:0} / {component.Goal:0}" : "keine Daten")
                        </span>
                    </div>
                }
            </div>
            <p class="score-card-hint">v1-Formel aus Schritten, aktiver Energie und Ruhepuls — ein Startpunkt, keine medizinische Bewertung.</p>
        </div>
    }

    @if (headlineCards.Count > 0)
    {
        <div class="stat-cards">
            @foreach (var card in headlineCards)
            {
                <div class="stat-card">
                    <div class="stat-card-label">@card.Label</div>
                    <div class="stat-card-value">@card.Value</div>
                    <div class="stat-card-sub">@card.Sub</div>
                </div>
            }
        </div>
    }

    @if (stepChartBuckets is { Count: > 0 })
    {
        <div class="card">
            <h2>Schritte — 7 Tage bis @SelectedDate.ToString("dd.MM.")</h2>
            <div class="bar-chart">
                @foreach (var b in stepChartBuckets)
                {
                    var heightPct = stepChartMax > 0 ? (b.Sum / stepChartMax * 100) : 0;
                    <div class="bar-chart-column">
                        <div class="bar-chart-bar" style="height: @(heightPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="@b.Sum.ToString("0") Schritte"></div>
                        <div class="bar-chart-label">@b.BucketStart.ToLocalTime().ToString("ddd")</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (otherTypes.Count > 0)
    {
        <div class="card">
            <h2>Weitere synchronisierte Werte</h2>
            <div class="model-list">
                @foreach (var type in otherTypes)
                {
                    <a class="model-suggestion" href="@("/reports?type=" + Uri.EscapeDataString(type))">@HealthTypeCatalog.GetDisplayName(type)</a>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? date { get; set; }

    private DateOnly SelectedDate => DateOnly.TryParse(date, out var parsed) ? parsed : DateOnly.FromDateTime(DateTime.Now);

    private bool isLoaded;
    private bool hasAnyData;
    private DailyScoreResult? score;
    private List<HeadlineCard> headlineCards = new();
    private List<ReportBucket>? stepChartBuckets;
    private double stepChartMax;
    private List<string> otherTypes = new();

    // Kuratierte Reihenfolge für die Kopf-Kacheln — nicht jeder Typ verdient eine Kachel, das wäre
    // wieder die rohe Tabelle nur in Kartenform. Alles andere landet unten als Link zu /reports.
    private static readonly (string Type, string Label, string Unit)[] HeadlineTypes =
    [
        ("stepCount", "Schritte", ""),
        ("activeEnergyBurned", "Aktive Energie", "kcal"),
        ("heartRate", "Herzfrequenz (Ø)", "bpm"),
        ("restingHeartRate", "Ruhepuls", "bpm"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var userId = HttpContext.User.RequireUserId();
        var summary = await ReportService.GetTypeSummaryAsync(userId);
        hasAnyData = summary.Count > 0;

        if (!hasAnyData)
        {
            isLoaded = true;
            return;
        }

        var anchorDate = SelectedDate.ToDateTime(TimeOnly.MinValue);
        score = await DailyScoreService.GetScoreAsync(userId, anchorDate);

        var availableTypes = summary.Select(s => s.Type).ToHashSet();

        foreach (var (type, label, unit) in HeadlineTypes)
        {
            if (!availableTypes.Contains(type))
            {
                continue;
            }

            var buckets = await ReportService.GetBucketsForDateAsync(userId, type, ReportPeriod.Day, anchorDate, daysBack: 7);

            // Samples carry whatever offset they were synced with (real syncs are UTC) while
            // SelectedDate is a local calendar date — compare local dates, not raw DateTimeOffset
            // instants, so "today" reliably matches today's samples regardless of offset.
            var selectedBucket = buckets.FirstOrDefault(b => DateOnly.FromDateTime(b.BucketStart.ToLocalTime().DateTime) == SelectedDate);

            // Herzfrequenz ist ein Durchschnittswert über den Tag sinnvoll, alles andere (Schritte,
            // Energie) eine Tagessumme.
            var isAverageMetric = type is "heartRate" or "restingHeartRate";

            if (selectedBucket is null)
            {
                headlineCards.Add(new HeadlineCard(label, "–", "Keine Daten an diesem Tag"));
            }
            else
            {
                var value = isAverageMetric ? selectedBucket.Average : selectedBucket.Sum;
                var sub = isAverageMetric ? $"Min {selectedBucket.Min:0} · Max {selectedBucket.Max:0}" : "";
                headlineCards.Add(new HeadlineCard(label, $"{value:0}{(string.IsNullOrEmpty(unit) ? "" : " " + unit)}", sub));
            }

            if (type == "stepCount" && buckets.Count > 0)
            {
                stepChartBuckets = buckets;
                stepChartMax = buckets.Max(b => b.Sum);
            }
        }

        var headlineTypeNames = HeadlineTypes.Select(h => h.Type).ToHashSet();
        otherTypes = availableTypes.Where(t => !headlineTypeNames.Contains(t)).OrderBy(t => t).ToList();

        isLoaded = true;
    }

    private static string FormatDayLabel(DateOnly d)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        if (d == today)
        {
            return "Heute";
        }

        if (d == today.AddDays(-1))
        {
            return "Gestern";
        }

        return d.ToString("dddd, dd.MM.yyyy", System.Globalization.CultureInfo.GetCultureInfo("de-DE"));
    }

    private record HeadlineCard(string Label, string Value, string Sub);
}
