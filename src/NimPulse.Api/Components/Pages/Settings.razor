@page "/settings"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using NimPulse.Core.Auth
@using NimPulse.Core.Health
@inject NimPulseDbContext Db

<PageTitle>Einstellungen — NimPulse</PageTitle>

<h1>Einstellungen</h1>

<h2>Sync</h2>

<EditForm Model="Input" OnValidSubmit="HandleSave" FormName="sync-settings" method="post" class="auth-form">
    <div class="field">
        <label for="syncWindow">Sync-Zeitraum</label>
        @* Bewusst ein rohes <select> statt <InputSelect>: InputSelect schreibt den gebundenen Wert
           in Static-SSR (keine Interactivity, kein blazor.web.js) nur als "value"-HTML-Attribut auf
           das <select>-Tag selbst — das ist kein gültiges HTML-Attribut für <select> und wird von
           echten Browsern ignoriert, ohne dass eine Option tatsächlich als ausgewählt erscheint.
           Ein rohes <select> mit explizitem "selected" pro <option> (wie schon in Reports.razor)
           funktioniert dagegen zuverlässig — der name-Attribut-Wert bindet weiterhin korrekt an
           [SupplyParameterFromForm] beim POST. *@
        <select id="syncWindow" name="Input.SyncWindowSelection">
            <option value="182" selected="@(Input.SyncWindowSelection == "182")">6 Monate</option>
            <option value="365" selected="@(Input.SyncWindowSelection == "365")">1 Jahr</option>
            <option value="730" selected="@(Input.SyncWindowSelection == "730")">2 Jahre</option>
            <option value="1095" selected="@(Input.SyncWindowSelection == "1095")">3 Jahre</option>
            <option value="all" selected="@(Input.SyncWindowSelection == "all")">Alles</option>
        </select>
    </div>

    @if (statusMessage is not null)
    {
        <p class="status">@statusMessage</p>
    }

    <button type="submit">Speichern</button>
</EditForm>

@if (isAdmin)
{
    <h2>Admin</h2>
    <p><a href="/settings/ki-gateway">KI-Gateway →</a></p>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private SyncSettingsModel Input { get; set; } = new();

    private bool isAdmin;
    private string? statusMessage;

    private bool IsPost => HttpContext.Request.Method == HttpMethods.Post;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = HttpContext.User.IsInRole("Admin");

        // Bei GET die aktuellen Werte aus der DB laden; bei POST steckt der Handler bereits die
        // vom Nutzer eingegebenen Werte in Input — die dürfen nicht überschrieben werden, bevor
        // HandleSave läuft (gleiches Muster wie in KiGatewaySettings.razor).
        if (!IsPost)
        {
            var userId = HttpContext.User.RequireUserId();
            var user = await Db.Users.FindAsync(userId);
            // "user?.SyncWindowDays ?? 30" würde ein echtes "Alles" (null INNERHALB eines
            // vorhandenen user) nicht von "kein user gefunden" unterscheiden können — beides wird
            // durch den ?? zu 30. Deshalb zweistufig, analog zu HealthSyncService.swift auf iOS.
            var days = user is null ? 30 : user.SyncWindowDays;
            Input.SyncWindowSelection = ToSelection(days);
        }
    }

    private async Task HandleSave()
    {
        var userId = HttpContext.User.RequireUserId();
        var user = await Db.Users.FindAsync(userId);
        if (user is null)
        {
            return;
        }

        user.SyncWindowDays = Input.SyncWindowSelection == "all" ? null : int.Parse(Input.SyncWindowSelection);
        await Db.SaveChangesAsync();

        statusMessage = "Gespeichert.";
    }

    /// Bildet einen gespeicherten Tage-Wert auf die nächstgrößere Picker-Option ab — betrifft vor
    /// allem den Alt-Default (30 Tage, aus der Zeit vor diesem Setting), der selbst keine der
    /// fünf Optionen ist.
    private static string ToSelection(int? days)
    {
        if (days is null)
        {
            return "all";
        }
        return days switch
        {
            <= 182 => "182",
            <= 365 => "365",
            <= 730 => "730",
            _ => "1095",
        };
    }

    private class SyncSettingsModel
    {
        // string statt int? — InputSelect<int?> spiegelt den geladenen Wert in Static-SSR nicht
        // zuverlässig in der Options-Auswahl wider (beobachtet: DB/Input-Wert korrekt 365, Dropdown
        // zeigte trotzdem die erste Option). String-Options (wie beim Provider-Picker auf der
        // KI-Gateway-Seite, der das nie hatte) umgehen das komplett.
        public string SyncWindowSelection { get; set; } = "182";
    }
}
