<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- /VERSION ist die Single Source of Truth (auch für den Git-Tag, siehe ci.yml) — hier
         zur Build-Zeit in die Assembly gebacken statt zur Laufzeit aus einer Datei gelesen,
         damit lokal/Docker/CI identisch funktionieren, ohne die Datei separat kopieren zu müssen. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NimPulse.Core\NimPulse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <!-- Nur für dotnet-ef-Design-Time-Tooling (Migrations erzeugen) — keine Laufzeit-Abhängigkeit. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
